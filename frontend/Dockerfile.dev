# ==============================================================================
# Development Frontend Dockerfile
# Supports Vite Hot Module Replacement (HMR)
# ==============================================================================

FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache wget

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ENV PORT=3000

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
