# ==============================================================================
# CV. BUANA LOGIKA UTAMA - SISTEM INFORMASI PENJUALAN WEB HOSTING
# Environment Variables Template (.env.example)
# Enforces 12-Factor App Configuration Principles
# ==============================================================================

# Application Meta
NODE_ENV=production
APP_NAME="CV. Buana Logika Utama Hosting"
APP_ENV=production
APP_URL=https://hosting.buanalogikautama.co.id
API_URL=https://hosting.buanalogikautama.co.id/api
DOMAIN_NAME=buanalogikautama.co.id
SSL_EMAIL=sysadmin@buanalogikautama.co.id

# Server Network & Port Binding
HTTP_PORT=80
HTTPS_PORT=443
BACKEND_PORT=5000
FRONTEND_PORT=3000
DATABASE_PORT=5432
REDIS_PORT=6379

# PostgreSQL Database Configuration
DB_CONNECTION=postgresql
DB_HOST=postgres_db
DB_PORT=5432
DB_DATABASE=buana_hosting_db
DB_USERNAME=buana_admin
DB_PASSWORD=change_this_super_secure_db_password_in_production
DB_MAX_CONNECTIONS=50
DB_TIMEOUT_MS=10000

# Redis Cache & Session Configuration
REDIS_HOST=redis_cache
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_auth_password_in_production
REDIS_DB=0

# Security & Authentication (JWT & Sessions)
JWT_SECRET=generate_min_64_char_cryptographically_secure_random_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_another_min_64_char_secure_random_key_here
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
SESSION_COOKIE_SECRET=generate_session_cookie_secret_key_here

# Rate Limiting (RNF-01, RNF-03)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_LOGIN_MAX=10

# Storage & Uploads (Bukti Transfer, Dokumen)
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# SMTP Email Notification Configuration (WBS 4.4.4 - Notifikasi Transaksi)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@buanalogikautama.co.id
SMTP_PASS=smtp_password_secret
MAIL_FROM_ADDRESS=noreply@buanalogikautama.co.id
MAIL_FROM_NAME="CV. Buana Logika Utama Billing"

# Automated Database Backup Configuration (RNF-08, WBS 7.5)
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/var/backups/postgres
BACKUP_SCHEDULE="0 2 * * *" # Daily at 02:00 AM UTC

# Logging Level
LOG_LEVEL=info

# AI Chatbot — Google Gemini API (Free Tier)
# Dapatkan API key GRATIS di: https://aistudio.google.com/app/apikey
# Free tier: 15 requests/menit, 1.500 requests/hari (cukup untuk development & produksi kecil)
GEMINI_API_KEY=your_gemini_api_key_here
